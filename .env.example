# Copy to .env. Never commit .env.

# Free key from https://console.groq.com (the headline benchmark runs on the Groq free tier).
GROQ_API_KEY=

# Defaults shown; change only if your ports differ.
# WARDEN_RPC_URL=http://127.0.0.1:8545
# WARDEN_SIGNER_URL=http://127.0.0.1:8201
# WARDEN_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional: send spans of published runs to Langfuse Cloud (OTLP/HTTP).
# WARDEN_OTLP_ENDPOINT=

# Optional: fix the session the MCP server proposes into (set by the user, never by the caller).
# WARDEN_MCP_SESSION_ID=
